// ==========================================
// MINI MEET - MAIN APPLICATION
// ==========================================

const { createClient } = supabase;

const db = createClient(
  window.APP_CONFIG.SUPABASE_URL,
  window.APP_CONFIG.SUPABASE_PUBLISHABLE_KEY
);

let currentMeet = null;
let swimmers = [];
let events = [];
let entries = [];
let results = [];
let heatSheets = [];

// ==========================================
// HELPERS
// ==========================================

const $ = (id) => document.getElementById(id);

function message(id, text, error = false) {
  const element = $(id);
  if (!element) return;

  element.textContent = text;
  element.style.color = error ? "#c0392b" : "#2674b8";
}

function showModal(id) {
  $(id).classList.remove("hidden");
}

function hideModal(id) {
  $(id).classList.add("hidden");
}

function escapeHTML(value) {
  return String(value ?? "").replace(/[&<>"']/g, character => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#039;"
  })[character]);
}

function parseTime(value) {
  const parts = String(value).trim().split(":");

  if (parts.length === 1) {
    const seconds = Number(parts[0]);
    return Number.isFinite(seconds) ? seconds : NaN;
  }

  if (parts.length === 2) {
    const minutes = Number(parts[0]);
    const seconds = Number(parts[1]);

    if (!Number.isFinite(minutes) || !Number.isFinite(seconds)) {
      return NaN;
    }

    return minutes * 60 + seconds;
  }

  if (parts.length === 3) {
    const hours = Number(parts[0]);
    const minutes = Number(parts[1]);
    const seconds = Number(parts[2]);

    if (![hours, minutes, seconds].every(Number.isFinite)) {
      return NaN;
    }

    return hours * 3600 + minutes * 60 + seconds;
  }

  return NaN;
}

function formatTime(seconds) {
  const minutes = Math.floor(seconds / 60);
  const remaining = (seconds % 60).toFixed(2).padStart(5, "0");

  if (minutes > 0) {
    return `${minutes}:${remaining}`;
  }

  return remaining;
}

function setOptions(element, items, placeholder) {
  if (!element) return;

  const previous = element.value;

  element.innerHTML =
    `<option value="">${escapeHTML(placeholder)}</option>` +
    items.map(item =>
      `<option value="${escapeHTML(item.value)}">${escapeHTML(item.label)}</option>`
    ).join("");

  if (items.some(item => String(item.value) === previous)) {
    element.value = previous;
  }
}

function getSwimmer(id) {
  return swimmers.find(swimmer => swimmer.id === id);
}

function getEvent(id) {
  return events.find(event => event.id === id);
}

function getEntry(id) {
  return entries.find(entry => entry.id === id);
}

// ==========================================
// PUBLIC WEBSITE
// ==========================================

async function loadPublic() {
  message("public-message", "Loading meet information...");

  try {
    const { data: meets, error } = await db
      .from("meets")
      .select("*")
      .eq("is_published", true)
      .order("meet_date", { ascending: false });

    if (error) throw error;

    if (!meets || meets.length === 0) {
      $("meet-title").textContent = "No published meet";
      $("meet-date").textContent = "Please check again later.";
      message("public-message", "");
      return;
    }

    currentMeet = meets[0];

    $("meet-title").textContent = currentMeet.name;
    $("meet-date").textContent = new Date(
      currentMeet.meet_date + "T12:00:00"
    ).toLocaleDateString("en-GB", {
      day: "numeric",
      month: "long",
      year: "numeric"
    });

    await loadMeetData();

    message("public-message", "");

  } catch (error) {
    console.error(error);
    message(
      "public-message",
      "Unable to load results. Please refresh the page.",
      true
    );
  }
}

async function loadMeetData() {
  if (!currentMeet) return;

  const [eventResponse, entryResponse, swimmerResponse, sheetResponse] =
    await Promise.all([
      db.from("events")
        .select("*")
        .eq("meet_id", currentMeet.id)
        .order("event_number"),

      db.from("entries")
        .select("*")
        .eq("status", "accepted"),

      db.from("swimmers")
        .select("*"),

      db.from("heat_sheets")
        .select("*")
        .eq("meet_id", currentMeet.id)
        .eq("is_published", true)
    ]);

  if (eventResponse.error) throw eventResponse.error;
  if (entryResponse.error) throw entryResponse.error;
  if (swimmerResponse.error) throw swimmerResponse.error;
  if (sheetResponse.error) throw sheetResponse.error;

  events = eventResponse.data || [];

  const eventIds = new Set(events.map(event => event.id));

  entries = (entryResponse.data || []).filter(entry =>
    eventIds.has(entry.event_id)
  );

  const swimmerIds = new Set(entries.map(entry => entry.swimmer_id));

  swimmers = (swimmerResponse.data || []).filter(swimmer =>
    swimmerIds.has(swimmer.id)
  );

  heatSheets = sheetResponse.data || [];

  const entryIds = entries.map(entry => entry.id);

  if (entryIds.length > 0) {
    const { data, error } = await db
      .from("results")
      .select("*")
      .in("entry_id", entryIds)
      .eq("is_published", true);

    if (error) throw error;

    results = data || [];
  } else {
    results = [];
  }

  renderPublic();
}

// ==========================================
// RENDER PUBLIC RESULTS
// ==========================================

function renderPublic() {
  renderFilters();
  renderResults();
  renderRankings();
  renderSwimmers();
  renderHeatSheets();
}

function renderFilters() {
  const eventOptions = events.map(event => ({
    value: event.id,
    label: `Event ${event.event_number} – ${event.event_name}`
  }));

  const ageGroups = [...new Set(swimmers.map(s => s.age_group))].sort();

  const ageOptions = ageGroups.map(age => ({
    value: age,
    label: age
  }));

  setOptions($("event-filter"), eventOptions, "All events");
  setOptions($("ranking-event-filter"), eventOptions, "All events");
  setOptions($("age-filter"), ageOptions, "All age groups");
  setOptions($("ranking-age-filter"), ageOptions, "All age groups");
}

function renderResults() {
  const search = $("swimmer-search").value.toLowerCase();
  const eventFilter = $("event-filter").value;
  const ageFilter = $("age-filter").value;

  let displayed = results.map(result => {
    const entry = getEntry(result.entry_id);
    if (!entry) return null;

    const swimmer = getSwimmer(entry.swimmer_id);
    const event = getEvent(entry.event_id);

    if (!swimmer || !event) return null;

    return { result, entry, swimmer, event };
  }).filter(Boolean);

  displayed = displayed.filter(item => {
    return (
      item.swimmer.full_name.toLowerCase().includes(search) &&
      (!eventFilter || item.event.id === eventFilter) &&
      (!ageFilter || item.swimmer.age_group === ageFilter)
    );
  });

  displayed.sort((a, b) => {
    if (a.event.event_number !== b.event.event_number) {
      return a.event.event_number - b.event.event_number;
    }

    return (a.result.position || 999) - (b.result.position || 999);
  });

  $("results-count").textContent =
    `${displayed.length} result${displayed.length === 1 ? "" : "s"}`;

  if (displayed.length === 0) {
    $("results-list").innerHTML =
      '<div class="empty-state">No published results found.</div>';
    return;
  }

  $("results-list").innerHTML = displayed.map(item => `
    <article class="result-card">
      <div>
        <h3>${escapeHTML(item.swimmer.full_name)}</h3>
        <p>${escapeHTML(item.event.event_name)}</p>
        <p>${escapeHTML(item.swimmer.age_group)}</p>
        <span class="position">
          ${item.result.position ? `Position ${item.result.position}` : ""}
        </span>
      </div>
      <div class="result-time">
        ${escapeHTML(item.result.time_display)}
      </div>
    </article>
  `).join("");
}

function renderRankings() {
  const ageFilter = $("ranking-age-filter").value;
  const eventFilter = $("ranking-event-filter").value;

  let displayed = results.map(result => {
    const entry = getEntry(result.entry_id);
    if (!entry) return null;

    const swimmer = getSwimmer(entry.swimmer_id);
    const event = getEvent(entry.event_id);

    if (!swimmer || !event) return null;

    return { result, entry, swimmer, event };
  }).filter(Boolean);

  displayed = displayed.filter(item =>
    (!ageFilter || item.swimmer.age_group === ageFilter) &&
    (!eventFilter || item.event.id === eventFilter)
  );

  displayed.sort((a, b) =>
    a.result.time_seconds - b.result.time_seconds
  );

  if (displayed.length === 0) {
    $("rankings-list").innerHTML =
      '<div class="empty-state">No rankings available yet.</div>';
    return;
  }

  $("rankings-list").innerHTML = displayed.map((item, index) => `
    <article class="ranking-card">
      <h3>${index + 1}. ${escapeHTML(item.swimmer.full_name)}</h3>
      <p>${escapeHTML(item.swimmer.age_group)} · ${escapeHTML(item.event.event_name)}</p>
      <p><strong>${escapeHTML(item.result.time_display)}</strong></p>
    </article>
  `).join("");
}

function renderSwimmers() {
  const search = $("swimmer-search").value.toLowerCase();

  const displayed = swimmers.filter(swimmer =>
    swimmer.full_name.toLowerCase().includes(search)
  );

  $("swimmers-count").textContent =
    `${displayed.length} swimmer${displayed.length === 1 ? "" : "s"}`;

  if (displayed.length === 0) {
    $("swimmers-list").innerHTML =
      '<div class="empty-state">No swimmers found.</div>';
    return;
  }

  $("swimmers-list").innerHTML = displayed
    .sort((a, b) => a.full_name.localeCompare(b.full_name))
    .map(swimmer => {
      const swimmerEntries = entries.filter(entry =>
        entry.swimmer_id === swimmer.id
      );

      return `
        <article class="swimmer-card">
          <h3>${escapeHTML(swimmer.full_name)}</h3>
          <p>${escapeHTML(swimmer.age_group)}</p>
          <p>${swimmerEntries.length} accepted event entries</p>
        </article>
      `;
    }).join("");
}

function renderHeatSheets() {
  if (heatSheets.length === 0) {
    $("heat-sheets-list").innerHTML =
      '<div class="empty-state">No heat sheets have been published yet.</div>';
    return;
  }

  $("heat-sheets-list").innerHTML = heatSheets.map(sheet => {
    const { data } = db.storage
      .from("heat-sheets")
      .getPublicUrl(sheet.file_path);

    return `
      <article class="heat-card">
        <h3>${escapeHTML(sheet.title)}</h3>
        <p>Official meet document</p>
        <a href="${escapeHTML(data.publicUrl)}" target="_blank" rel="noopener">
          Open document
        </a>
      </article>
    `;
  }).join("");
}

// ==========================================
// PUBLIC SEARCH AND FILTERS
// ==========================================

$("swimmer-search").addEventListener("input", () => {
  renderResults();
  renderSwimmers();
});

$("search-clear").addEventListener("click", () => {
  $("swimmer-search").value = "";
  renderResults();
  renderSwimmers();
});

$("event-filter").addEventListener("change", renderResults);
$("age-filter").addEventListener("change", renderResults);
$("ranking-age-filter").addEventListener("change", renderRankings);
$("ranking-event-filter").addEventListener("change", renderRankings);

// ==========================================
// TABS
// ==========================================

document.querySelectorAll(".tab").forEach(button => {
  button.addEventListener("click", () => {
    document.querySelectorAll(".tab").forEach(tab =>
      tab.classList.remove("active")
    );

    document.querySelectorAll(".content-section").forEach(section =>
