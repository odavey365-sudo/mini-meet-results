// ==========================================
// ADMIN LOGIN
// ==========================================

$("admin-open").addEventListener("click", async () => {
  const { data } = await db.auth.getSession();

  if (data.session) {
    await checkAdmin(data.session.user);
  } else {
    showModal("login-modal");
  }
});

document.querySelectorAll("[data-close]").forEach(button => {
  button.addEventListener("click", () => {
    hideModal(button.dataset.close);
  });
});

$("login-form").addEventListener("submit", async event => {
  event.preventDefault();

  message("login-message", "Signing in...");

  const email = $("login-email").value.trim();
  const password = $("login-password").value;

  const { data, error } = await db.auth.signInWithPassword({
    email,
    password
  });

  if (error) {
    message("login-message", error.message, true);
    return;
  }

  await checkAdmin(data.user);
});

async function checkAdmin(user) {
  const { data, error } = await db
    .from("admin_users")
    .select("user_id")
    .eq("user_id", user.id)
    .maybeSingle();

  if (error || !data) {
    await db.auth.signOut();
    message(
      "login-message",
      "This account is not authorised as an administrator.",
      true
    );
    return;
  }

  hideModal("login-modal");
  showModal("admin-modal");

  message("admin-message", "Administrator access confirmed.");

  await loadAdminData();
}

$("admin-logout").addEventListener("click", async () => {
  await db.auth.signOut();
  hideModal("admin-modal");
  message("admin-message", "You have signed out.");
});

// ==========================================
// ADMIN DATA
// ==========================================

async function loadAdminData() {
  const [meetResponse, swimmerResponse, eventResponse, entryResponse] =
    await Promise.all([
      db.from("meets")
        .select("*")
        .order("meet_date", { ascending: false }),

      db.from("swimmers").select("*").order("full_name"),

      db.from("events").select("*").order("event_number"),

      db.from("entries").select("*")
    ]);

  if (meetResponse.error) throw meetResponse.error;
  if (swimmerResponse.error) throw swimmerResponse.error;
  if (eventResponse.error) throw eventResponse.error;
  if (entryResponse.error) throw entryResponse.error;

  swimmers = swimmerResponse.data || [];
  events = eventResponse.data || [];
  entries = entryResponse.data || [];

  if (currentMeet) {
    const matchingMeet = (meetResponse.data || []).find(
      meet => meet.id === currentMeet.id
    );

    if (matchingMeet) currentMeet = matchingMeet;
  }

  if (!currentMeet && meetResponse.data.length > 0) {
    currentMeet = meetResponse.data[0];
  }

  if (currentMeet) {
    $("meet-name-input").value = currentMeet.name;
    $("meet-date-input").value = currentMeet.meet_date;
    $("meet-published").checked = currentMeet.is_published;
  }

  populateAdminSelects();
}

function populateAdminSelects() {
  const swimmerOptions = swimmers.map(swimmer => ({
    value: swimmer.id,
    label: `${swimmer.full_name} (${swimmer.age_group})`
  }));

  const eventOptions = events
    .filter(event => currentMeet && event.meet_id === currentMeet.id)
    .map(event => ({
      value: event.id,
      label: `Event ${event.event_number} – ${event.event_name}`
    }));

  const entryOptions = entries
    .filter(entry => {
      const event = getEvent(entry.event_id);
      return event && currentMeet && event.meet_id === currentMeet.id;
    })
    .map(entry => {
      const swimmer = getSwimmer(entry.swimmer_id);
      const event = getEvent(entry.event_id);

      return {
        value: entry.id,
        label: `${swimmer?.full_name || "Unknown"} – ${event?.event_name || "Unknown"} – Heat ${entry.heat_number}, Lane ${entry.lane_number}`
      };
    });

  setOptions($("entry-swimmer-input"), swimmerOptions, "Select swimmer");
  setOptions($("entry-event-input"), eventOptions, "Select event");
  setOptions($("result-entry-input"), entryOptions, "Select entry");
}

// ==========================================
// SAVE MEET
// ==========================================

$("meet-form").addEventListener("submit", async event => {
  event.preventDefault();

  message("admin-message", "Saving meet...");

  const meetData = {
    name: $("meet-name-input").value.trim(),
    meet_date: $("meet-date-input").value,
    is_published: $("meet-published").checked
  };

  let response;

  if (currentMeet) {
    response = await db.from("meets")
      .update(meetData)
      .eq("id", currentMeet.id)
      .select()
      .single();
  } else {
    response = await db.from("meets")
      .insert(meetData)
      .select()
      .single();
  }

  if (response.error) {
    message("admin-message", response.error.message, true);
    return;
  }

  currentMeet = response.data;

  message("admin-message", "Meet saved successfully.");

  await loadPublic();
  await loadAdminData();
});

