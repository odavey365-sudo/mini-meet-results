// ADD SWIMMER
// ==========================================

$("swimmer-form").addEventListener("submit", async event => {
  event.preventDefault();

  const fullName = $("swimmer-name-input").value.trim();
  const ageGroup = $("swimmer-age-input").value.trim();

  const { data, error } = await db.from("swimmers")
    .insert({
      full_name: fullName,
      age_group: ageGroup
    })
    .select()
    .single();

  if (error) {
    message("admin-message", error.message, true);
    return;
  }

  $("swimmer-form").reset();

  message("admin-message", `${data.full_name} added successfully.`);

  await loadAdminData();
  await loadPublic();
});

// ==========================================
// ADD EVENT
// ==========================================

$("event-form").addEventListener("submit", async event => {
  event.preventDefault();

  if (!currentMeet) {
    message("admin-message", "Create a meet first.", true);
    return;
  }

  const eventData = {
    meet_id: currentMeet.id,
    event_number: Number($("event-number-input").value),
    event_name: $("event-name-input").value.trim(),
    distance: Number($("event-distance-input").value),
    stroke: $("event-stroke-input").value
  };

  const { error } = await db.from("events").insert(eventData);

  if (error) {
    message("admin-message", error.message, true);
    return;
  }

  $("event-form").reset();

  message("admin-message", "Event added successfully.");

  await loadAdminData();
  await loadPublic();
});

// ==========================================
// ADD ENTRY
// ==========================================

$("entry-form").addEventListener("submit", async event => {
  event.preventDefault();

  const entryData = {
    swimmer_id: $("entry-swimmer-input").value,
    event_id: $("entry-event-input").value,
    heat_number: Number($("entry-heat-input").value),
