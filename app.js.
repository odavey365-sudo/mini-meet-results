  $("entry-form").reset();

  message("admin-message", "Swimmer added to event.");

  await loadAdminData();
  await loadPublic();
});

// ==========================================
// ENTER RESULT
// ==========================================

$("result-form").addEventListener("submit", async event => {
  event.preventDefault();

  const entryId = $("result-entry-input").value;
  const timeDisplay = $("result-time-input").value.trim();
  const timeSeconds = parseTime(timeDisplay);

  if (!entryId || !Number.isFinite(timeSeconds) || timeSeconds < 0) {
    message("admin-message", "Enter a valid race time.", true);
    return;
  }

  const positionValue = $("result-position-input").value;

  const resultData = {
    entry_id: entryId,
    time_seconds: timeSeconds,
    time_display: formatTime(timeSeconds),
    position: positionValue ? Number(positionValue) : null,
    is_published: $("result-published-input").checked
  };

  const { error } = await db.from("results")
    .upsert(resultData, { onConflict: "entry_id" });

  if (error) {
    message("admin-message", error.message, true);
    return;
  }

  $("result-form").reset();

  message("admin-message", "Result saved successfully.");

  await loadPublic();
});

// ==========================================
// UPLOAD HEAT SHEET
// ==========================================

$("heat-sheet-form").addEventListener("submit", async event => {
  event.preventDefault();

  if (!currentMeet) {
    message("admin-message", "Create a meet first.", true);
    return;
  }

  const file = $("heat-sheet-file-input").files[0];

  if (!file) {
    message("admin-message", "Choose a file first.", true);
    return;
  }

  const allowedExtensions = /\.(pdf|xls|xlsx|csv)$/i;

  if (!allowedExtensions.test(file.name)) {
    message("admin-message", "Please choose a PDF, Excel or CSV file.", true);
    return;
  }

  if (file.size > 15 * 1024 * 1024) {
    message("admin-message", "The file must be smaller than 15 MB.", true);
    return;
  }

  message("admin-message", "Uploading document...");

  const safeName = file.name.replace(/[^a-zA-Z0-9._-]/g, "_");
  const filePath = `${currentMeet.id}/${Date.now()}-${safeName}`;

  const { error: uploadError } = await db.storage
    .from("heat-sheets")
    .upload(filePath, file);

  if (uploadError) {
    message("admin-message", uploadError.message, true);
    return;
  }

  const { error: recordError } = await db.from("heat_sheets")
    .insert({
      meet_id: currentMeet.id,
      title: $("heat-sheet-title-input").value.trim(),
      file_path: filePath,
      is_published: $("heat-sheet-published-input").checked
    });

  if (recordError) {
    message(
      "admin-message",
      `File uploaded but its record could not be saved: ${recordError.message}`,
      true
    );
    return;
  }

  $("heat-sheet-form").reset();

  message("admin-message", "Heat sheet uploaded successfully.");

  await loadPublic();
});

// ==========================================
// INITIAL PAGE LOAD
// ==========================================

async function startApp() {
  try {
    await loadPublic();

    const { data } = await db.auth.getSession();

    if (data.session) {
      await checkAdmin(data.session.user);
    }
  } catch (error) {
    console.error(error);
    message("public-message", error.message, true);
  }
}

startApp();
